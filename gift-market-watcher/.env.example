# Ключи с https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Имя файла сессии для bench.py (создастся при первом входе). Аккаунт — НЕ основной.
TG_SESSION=bench
# Сессии для сборщика, через запятую (каждая — отдельный аккаунт). Логин: python -m gmw login
TG_SESSIONS=bench

# Пауза между запросами одного аккаунта, сек (от конца предыдущего запроса).
# Замер 04.10: 0.1 с → FLOOD_WAIT 37 с на 41-м запросе; 1.5 с → 81 запрос без флуда. 2 с — с запасом.
GMW_REQUEST_INTERVAL=2.0
# Параллельных задач (по умолчанию = числу аккаунтов) и полных сканов одновременно (по умолчанию = задач/4)
#GMW_WORKERS=
#GMW_MAX_FULL=
# Файл, где хранятся сроки FLOOD_WAIT (переживают рестарт)
GMW_FLOOD_STATE=flood_state.json
# Горячий скан: интервал на коллекцию подстраивается под активность в пределах [HOT_MIN, HOT_MAX], сек
GMW_HOT_MIN=5
GMW_HOT_MAX=120
# Полный скан коллекции (ловит продажи и снятия), сек
GMW_FULL_INTERVAL=600

# Для локального запуска без Docker (в Docker подставляются сами)
GMW_DATABASE_URL=postgresql://gmw:gmw@localhost:5432/gmw
GMW_REDIS_URL=redis://localhost:6379/0

# Порт API на сервере (слушает только 127.0.0.1) и токен доступа к API. install.sh заполнит сам.
GMW_HOST_PORT=8040
GMW_API_TOKEN=
